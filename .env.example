# Local example. Use the environment's own Supabase project in Vercel.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key from the same local or remote Supabase project.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server-only settings. Configure secret values in the local environment or Vercel.
SUPABASE_SECRET_KEY=
ACTIVATION_CODE_ENCRYPTION_KEY=
ADMIN_NOTIFICATION_EMAIL=admin@jmmcdevsign.es
MEMBERSHIP_MAIL_FROM=
RESEND_API_KEY=
MEMBERSHIP_MAIL_CRON_SECRET=
