# Public Supabase project URL. Leave empty to keep the mock-only runtime.
NEXT_PUBLIC_SUPABASE_URL=

# Public anon/publishable key. Never put a service_role or secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public site URL used by future integrations and metadata.
NEXT_PUBLIC_SITE_URL=https://www.jmmcdevsign.es

# Recipient for future admin notifications; local mail remains mock-only.
ADMIN_NOTIFICATION_EMAIL=admin@jmmcdevsign.es
