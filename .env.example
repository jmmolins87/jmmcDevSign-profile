# Environment variables (guidelines §12). Copy to `.env` for local dev; never
# commit `.env`.

# ── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://127.0.0.1:6379
WEB_URL=https://jmmcdevsign.es
API_URL=https://api.jmmcdevsign.es

# ── Better Auth (sessions cookies) ────────────────────────────────────────
BETTER_AUTH_SECRET=

# ── OAuth providers ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Email (Resend in production, Mailpit locally) ─────────────────────────
RESEND_API_KEY=
MAIL_FROM=hola@jmmcdevsign.es

# ── Admin approval flow (§5) ──────────────────────────────────────────────
ADMIN_EMAIL=hola@jmmcdevsign.es
APPROVAL_TOKEN_SECRET=

# ── AI (demo 05/07, provider swappable) ───────────────────────────────────
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=

# ── Supabase (Storage; service role key is SERVER ONLY) ───────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
