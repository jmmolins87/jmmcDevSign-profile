{
  "name": "jmmcdevsign-profile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "stylelint": "stylelint \"**/*.css\" --ignore-path .gitignore",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "db:migrate": "pnpm --filter @jmmcdev/api db:migrate",
    "db:seed": "pnpm --filter @jmmcdev/api db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "stylelint": "^16.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
