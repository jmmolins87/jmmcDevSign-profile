{
  "name": "@jmmcdev/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API for the JMMC portfolio.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config src/drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env ./node_modules/drizzle-kit/bin.cjs migrate --config src/drizzle.config.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@jmmcdev/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0",
    "typescript": "^5.0.0"
  }
}
